# Read by desktop-client in this folder, set up to play on {{ domain }}.
# Every line is explained at https://{{ domain }}/downloads#rift-env

RIFT_CLIENT_GAME_SERVER_URL={{ game_server_url }}
RIFT_CLIENT_GAME_SERVER_WS_URL={{ game_server_ws_url }}
RIFT_CLIENT_AUTH=oidc
RIFT_CLIENT_PROFILE_DIR=profile
RIFT_CLIENT_EXIT_ON_STDIN_EOF=false

RIFT_AUTH_CLIENT_ID={{ sign_in.client_id }}
RIFT_AUTH_AUTHORIZATION_URI={{ sign_in.authorization_uri }}
RIFT_AUTH_SIGN_UP_URI={{ sign_in.sign_up_uri }}
RIFT_AUTH_TOKEN_URI={{ sign_in.token_uri }}
