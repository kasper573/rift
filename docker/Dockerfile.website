FROM rust:1-alpine AS builder
RUN apk add --no-cache musl-dev
WORKDIR /workdir
COPY . .
# Build outputs live in the target cache mount, so they are copied out within this step.
RUN --mount=type=cache,id=rustup-website,target=/usr/local/rustup \
    --mount=type=cache,id=cargo-registry-website,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-target-website,target=/workdir/target \
    cargo x wasm \
    && cargo build --release -p website \
    && mkdir -p /game \
    && cp target/game-client/client.wasm target/game-client/mq_js_bundle.js /game/ \
    && cp target/release/website /usr/local/bin/website

FROM alpine:3.21
COPY --from=builder /usr/local/bin/website /usr/local/bin/website
COPY --from=builder /game/ /game/
ENV MP_GAME_CLIENT_WASM=/game/client.wasm
ENV MP_MQ_JS_BUNDLE=/game/mq_js_bundle.js
ENTRYPOINT ["website"]
