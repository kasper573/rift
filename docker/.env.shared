# OpenTelemetry standard (the reverse proxy emits traces)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_LOG_LEVEL="error"

# Postgres
POSTGRES_USER=rift
POSTGRES_PASSWORD=rift
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Observability
METRICS_SCRAPE_INTERVAL_MS=${METRICS_SCRAPE_INTERVAL_MS:-15000}
METRICS_SCRAPE_TIMEOUT_MS=${METRICS_SCRAPE_TIMEOUT_MS:-5000}
NODE_EXPORTER_TARGET=node_exporter:9100
POSTGRES_EXPORTER_TARGET=postgres_exporter:9187
KEYCLOAK_MGMT_TARGET=keycloak:9000
KEYCLOAK_TARGET=keycloak:8080
GRAFANA_TARGET=grafana:3000
MIMIR_BASE=http://mimir:9009
LOKI_BASE=http://loki:3100
TEMPO_QUERY=http://tempo:3200
PYROSCOPE_BASE=http://pyroscope:4040

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_ROOT_URL=https://grafana.${RIFT_DOMAIN}
PROMETHEUS_SCRAPE_INTERVAL=${METRICS_SCRAPE_INTERVAL_MS}ms
PROMETHEUS_SCRAPE_TIMEOUT=${METRICS_SCRAPE_TIMEOUT_MS}ms

# Keycloak keeps its data in its own database; game data has no persistence yet,
# but the mechanism creates one database (and owner user) per listed name.
POSTGRES_INFRA_DB=rift_infra
POSTGRES_MULTIPLE_DATABASES=${POSTGRES_INFRA_DB}

# Postfix
ALLOWED_SENDER_DOMAINS=${RIFT_DOMAIN}
HOSTNAME=mail.${RIFT_DOMAIN}

# Postgres exporter
DATA_SOURCE_USER=${POSTGRES_USER}
DATA_SOURCE_PASS=${POSTGRES_PASSWORD}

# Reverse proxy
CADDY_RATE_LIMIT_EVENTS=${CADDY_RATE_LIMIT_EVENTS:-999999}

# Keycloak
KC_PUBLIC_BASE_URL=http://keycloak:8080
KC_VERIFY_EMAIL=${KC_VERIFY_EMAIL:-false}
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_INFRA_DB}?user=${POSTGRES_USER}&password=${POSTGRES_PASSWORD}
KC_DB_USERNAME=${POSTGRES_USER}
KC_DB_PASSWORD=${POSTGRES_PASSWORD}
KC_HOSTNAME=https://auth.${RIFT_DOMAIN}
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_SMTP_FROM=no-reply@${RIFT_DOMAIN}
KC_SMTP_FROM_DISPLAY_NAME=Rift
KC_SMTP_HOST=postfix
KC_SMTP_PORT=587
KC_SMTP_AUTH=false # Postfix doesn't require auth

RIFT_VERSION=${RIFT_VERSION:-0.0.0}

RIFT_AUTH_AUDIENCE=rift
RIFT_AUTH_ISSUER=${KC_HOSTNAME}/realms/${RIFT_AUTH_AUDIENCE}
RIFT_AUTH_JWKS_URI=${KC_PUBLIC_BASE_URL}/realms/${RIFT_AUTH_AUDIENCE}/protocol/openid-connect/certs
RIFT_AUTH_TOKEN_URI=${KC_PUBLIC_BASE_URL}/realms/${RIFT_AUTH_AUDIENCE}/protocol/openid-connect/token

# The HTTP API (session/health) and the WebSocket netcode transport listen on separate ports; Caddy
# fronts both under RIFT_GAME_SERVER_DOMAIN, splitting traffic by the WebSocket upgrade handshake.
RIFT_GAME_SERVER_PORT=9998
RIFT_GAME_SERVER_WS_PORT=9999
RIFT_GAME_SERVER_PROXY_HOST=${RIFT_GAME_SERVER_PROXY_HOSTNAME:-rift-game-server}:${RIFT_GAME_SERVER_PORT}
RIFT_GAME_SERVER_WS_PROXY_HOST=${RIFT_GAME_SERVER_PROXY_HOSTNAME:-rift-game-server}:${RIFT_GAME_SERVER_WS_PORT}
RIFT_GAME_SERVER_DOMAIN=game-server.${RIFT_DOMAIN}
# Continuous profiling to PYROSCOPE_BASE. 99 Hz (not 100) avoids sampling in lockstep with the
# fixed-rate simulation tick, which would bias the profile toward one phase of the tick.
RIFT_GAME_SERVER_PYROSCOPE_ENABLED=${RIFT_GAME_SERVER_PYROSCOPE_ENABLED:-true}
RIFT_GAME_SERVER_PYROSCOPE_SAMPLE_HZ=${RIFT_GAME_SERVER_PYROSCOPE_SAMPLE_HZ:-99}

RIFT_WEBSITE_DOMAIN=${RIFT_DOMAIN}
RIFT_WEBSITE_PORT=80
RIFT_WEBSITE_PROXY_HOST=${RIFT_WEBSITE_PROXY_HOSTNAME:-rift-website}:${RIFT_WEBSITE_PORT}
RIFT_WEBSITE_REDIRECT_URI=https://${RIFT_WEBSITE_DOMAIN}/auth-callback
# The game-server origins the website injects into /play for the wasm client: https for the session
# request, wss for the netcode connection. And the in-image directory the website serves the wasm
# bundle from (baked by `just wasm` → the Dockerfile's website stage).
RIFT_WEBSITE_GAME_SERVER_URL=https://${RIFT_GAME_SERVER_DOMAIN}
RIFT_WEBSITE_GAME_SERVER_WS_URL=wss://${RIFT_GAME_SERVER_DOMAIN}
RIFT_WEBSITE_WASM_DIR=/wasm
RIFT_WEBSITE_PYROSCOPE_ENABLED=${RIFT_WEBSITE_PYROSCOPE_ENABLED:-true}
RIFT_WEBSITE_PYROSCOPE_SAMPLE_HZ=${RIFT_WEBSITE_PYROSCOPE_SAMPLE_HZ:-100}
