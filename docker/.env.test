# These are the default container environment variables for test.
# Do not put secrets here. Secrets exist on the server instance.
RIFT_DOMAIN=rift.lan
# rift.lan isn't a public domain, so Caddy issues its certs from its own internal CA (trust it locally).
CADDY_LOCAL_CERTS=local_certs
# Console access for local development only; production bootstraps no admin from the stack.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# Players can't die in test/dev, so e2e crossings and local play aren't cut short by NPCs.
RIFT_GAME_SERVER_PLAYER_IMMORTAL=true
