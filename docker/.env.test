# These are the default container environment variables for test.
# Do not put secrets here. Secrets exist on the server instance.
RIFT_DOMAIN=rift.localhost
# Console access for local development only; production bootstraps no admin from the stack.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# The e2e walks an idle player across the island to a portal; with the normal ~30 HP the island's
# NPCs kill it first (and the death overlay tints the whole scene red), so the test stack spawns
# players effectively immortal. Production sets no override — real players use the in-game default.
RIFT_GAME_SERVER_PLAYER_HEALTH=1000000
