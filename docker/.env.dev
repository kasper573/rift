# These are the default container environment variables for development.
# Do not put secrets here.
RIFT_DOMAIN=rift.localhost
METRICS_SCRAPE_INTERVAL_MS=2000
METRICS_SCRAPE_TIMEOUT_MS=1000
RIFT_WEBSITE_PROXY_HOSTNAME=dev
RIFT_WEBSITE_PORT=5173
RIFT_GAME_SERVER_PROXY_HOSTNAME=dev
RIFT_GAME_SERVER_AUTH__ALLOW_BYPASS_USERS=true
# Paths are relative to the workspace root where `cargo x dev` runs the website
RIFT_GAME_CLIENT_WASM=target/game-client/client.wasm
RIFT_MQ_JS_BUNDLE=target/game-client/mq_js_bundle.js
