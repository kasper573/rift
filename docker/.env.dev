# These are the default container environment variables for development.
# Do not put secrets here.
MP_DOMAIN=mp.localhost
METRICS_SCRAPE_INTERVAL_MS=2000
METRICS_SCRAPE_TIMEOUT_MS=1000
MP_WEBSITE_PROXY_HOSTNAME=dev
MP_WEBSITE_PORT=5173
MP_GAME_SERVER_PROXY_HOSTNAME=dev
MP_GAME_SERVER_AUTH__ALLOW_BYPASS_USERS=true
# Paths are relative to the workspace root where `cargo x dev` runs the website
MP_GAME_CLIENT_WASM=target/game-client/client.wasm
MP_MQ_JS_BUNDLE=target/game-client/mq_js_bundle.js
