{
	order rate_limit before basicauth
    email admin@{$RIFT_DOMAIN}
}

(common_rate_limit) {
    rate_limit {
        zone dynamic_zone {
            key {http.request.remote_ip}
            events {$CADDY_RATE_LIMIT_EVENTS}
            window 5s
        }
    }
}

(common_cors) {
    @options {
        method OPTIONS
    }
    header {
        Access-Control-Allow-Origin "https://{$RIFT_WEBSITE_DOMAIN}"
        Access-Control-Allow-Methods "GET, POST, HEAD, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
        Access-Control-Allow-Credentials true
    }
    respond @options 204
}

# Access logs on a shared volume for fail2ban; iso8601 timestamps so its date detection works.
(access_log) {
    log {
        output file /var/log/caddy/access.log
        format json {
            time_format iso8601
        }
    }
}

grafana.{$RIFT_DOMAIN} {
    import access_log
    reverse_proxy {$GRAFANA_TARGET}
}

auth.{$RIFT_DOMAIN} {
    import access_log
    tracing {
        span keycloak
    }
    reverse_proxy {$KEYCLOAK_TARGET}
}

# Metrics and profiling endpoints are for the internal alloy scraper, never the public internet.
(internal_endpoints) {
    @internal path /metrics /debug/pprof/*
    respond @internal 404
}

{$RIFT_WEBSITE_DOMAIN} {
    import access_log
    import common_rate_limit
    import internal_endpoints
    # The wasm client bundle is large but highly compressible; compress it (and the html/js) so the
    # browser downloads a fraction of the on-disk size.
    encode zstd gzip
    reverse_proxy {$RIFT_WEBSITE_PROXY_HOST}
}

# The browser opens the netcode WebSocket here (terminated to plain ws toward the server) and POSTs
# `/session`/`/health` to the HTTP API — two separate listeners, split by the upgrade handshake.
{$RIFT_GAME_SERVER_DOMAIN} {
    import access_log
    import common_rate_limit
    import internal_endpoints
    tracing {
        span rift_game_server
    }
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket {$RIFT_GAME_SERVER_WS_PROXY_HOST}
    reverse_proxy {$RIFT_GAME_SERVER_PROXY_HOST}
    import common_cors
}
