{
  "actions": {
    "interact": {
      "label": "Walk, attack, talk or pick up",
      "bindings": [
        {
          "type": "mouse",
          "button": "Left"
        }
      ]
    },
    "select": {
      "label": "Select a row or tick a box",
      "bindings": [
        {
          "type": "click",
          "button": "Left",
          "times": 1
        }
      ]
    },
    "inspect_item": {
