{
  "actions": {
    "interact": {
      "label": "Walk, attack, talk or pick up",
      "bindings": [
        {
          "type": "mouse",
          "button": "Left"
        }
      ]
    },
    "select": {
      "label": "Select a row or tick a box",
      "bindings": [
        {
          "type": "click",
          "button": "Left",
          "times": 1
        }
      ]
    },
    "inspect_item": {
      "label": "Show an item's card",
      "bindings": [
        {
          "type": "click",
          "button": "Right",
          "times": 1
        }
      ]
    },
    "use_item": {
      "label": "Use, wear or take off an item",
      "bindings": [
        {
          "type": "click",
          "button": "Left",
          "times": 2
        }
      ]
    },
    "drop_item": {
      "label": "Drop an item from your bag",
      "bindings": [
        {
          "type": "click",
          "button": "Left",
          "times": 1,
          "ctrl": true
        }
      ]
    },
    "sell_item": {
      "label": "Sell an item to the open shop",
      "bindings": [
        {
          "type": "click",
          "button": "Right",
          "times": 1
        }
      ]
    },
    "place_item": {
      "label": "Place one of an item in the open prompt",
      "bindings": [
        {
          "type": "click",
          "button": "Right",
          "times": 1
        }
      ]
