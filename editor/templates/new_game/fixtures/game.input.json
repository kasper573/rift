    "carry_item": {
      "label": "Carry an item or a skill to where it goes",
      "bindings": [
        {
          "type": "drag",
          "button": "Left"
        }
      ]
    },
    "open_character": {
      "label": "Open the Character tab",
      "bindings": [
        {
          "type": "key",
          "key": "KeyI"
        }
      ]
    },
    "open_skills": {
      "label": "Open the Skills tab",
      "bindings": [
        {
          "type": "key",
          "key": "KeyP"
